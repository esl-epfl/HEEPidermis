	(gr_text "The VCO N reads the tissue's voltage\nto get the drop from the current drained\nby the 8-bit iDAC\n"
		(at 147.09 86.22 0)
		(layer "B.SilkS")
		(uuid "37ac20e5-80d9-4893-b145-e9c3a0292641")
		(effects
			(font
				(size 0.7 0.7)
				(thickness 0.15)
				(bold yes)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "The VCO P reads the battery level to:\n- monitor battery charge\n- generate the system clock\n- generate a sub-carrier for load-modulation\n- use as reference for pseudo-differential mode"
		(at 147.169 82.13 0)
		(layer "B.SilkS")
		(uuid "7636e9ce-a3dd-4683-8da4-1ca0c6a96bee")
		(effects
			(font
				(size 0.7 0.7)
				(thickness 0.15)
				(bold yes)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "The LDO generates 0.8V to\n- bias the tissue\n- supply the MCU"
